# Ignore LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg
*.lof
*.lot
*.nav
*.snm
*.vrb
*.xdv

# Ignore temp files from editors
*~
*.swp
*.swo
*.bak

# Ignore any hidden system files
.DS_Store
Thumbs.db

# Ignore any latexmk or arara state files
*.latexmk
*.arara

# Ignore any temp listing files (for code listings)
*-temp.listing

# Ignore any other temp/auxiliary files in Resume subfolder
Resume/*.aux
Resume/*.log
Resume/*.out
Resume/*.toc
Resume/*.synctex.gz
Resume/*.fdb_latexmk
