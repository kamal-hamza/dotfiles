#!/usr/bin/env python3
"""Query the music library for the quickshell Library launcher mode.

Reads beets' library.db directly (read-only) so browsing/playback matches
exactly what music-import tagged -- no separate index to keep in sync.
Artists are individual contributors, not raw ALBUMARTIST/ARTIST tag
strings, so a collab track shows up under every one of its artists
instead of only its joined credit string.

Usage:
  music-library artists
  music-library albums <artist>
  music-library tracks <artist> [<album>]
  music-library all-albums
  music-library album-tracks <album> <albumartist>
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib' / 'music'))
import musiclib as m


def main():
    if len(sys.argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    cmd, rest = sys.argv[1], sys.argv[2:]
    if cmd == 'artists':
        for name in m.list_artists():
            print(name)
    elif cmd == 'albums' and rest:
        print(json.dumps(m.list_albums(rest[0])))
    elif cmd == 'tracks' and rest:
        for p in m.artist_tracks(rest[0], rest[1] if len(rest) > 1 else None):
            print(p)
    elif cmd == 'all-albums':
        print(json.dumps(m.list_all_albums()))
    elif cmd == 'album-tracks' and len(rest) >= 2:
        for p in m.album_tracks(rest[0], rest[1]):
            print(p)
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
