#!/usr/bin/env python3
"""Backfill .lrc lyrics for FLACs in ~/Music that don't have one yet.

Queries LRCLib.net by artist/title/album/duration; writes a .lrc sidecar
next to the FLAC when a synced-lyrics match is found. Safe to run
anytime, as often as you like -- only touches files missing a .lrc.
"""
import signal
import sys
from pathlib import Path

signal.signal(signal.SIGPIPE, signal.SIG_DFL)
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib' / 'music'))
import musiclib as m


def main():
    m.setup()
    result = m.backfill_lyrics()
    print(f"checked {result['checked']} file(s) without lyrics, fetched {result['fetched']}")


if __name__ == '__main__':
    main()
