# =============================================================================
# PowerShell 7 profile (Windows) - GENERATED by chezmoi
# =============================================================================
# Env, PATH and aliases come from home/.chezmoidata/shell.yaml (shared with
# fish) - edit that file, not this one. Machine-specific additions go in
# ~/.config/powershell/dev-tools/*.ps1 (not tracked by chezmoi).
#
# NOTE: if OneDrive redirects Documents, $PROFILE points at
# OneDrive\Documents\PowerShell\... instead of where chezmoi writes this file.
# Check `$PROFILE` on the machine; if it differs, add a one-line profile there:
#   . "$HOME\Documents\PowerShell\Microsoft.PowerShell_profile.ps1"
# =============================================================================
{{- $os := .chezmoi.os }}

# --- env
{{- $env := merge (dict) (index .shell.env $os | default dict) .shell.env.common }}
{{- range $name := keys $env | sortAlpha }}
$env:{{ $name }} = "{{ index $env $name | toString | replace "`" "``" | replace "\"" "`\"" }}"
{{- end }}

# --- PATH (first entry ends up first; missing directories skipped)
{{- $path := concat (index .shell.path $os | default list) .shell.path.common }}
foreach ($dir in @({{ range $i, $d := $path | reverse }}{{ if $i }}, {{ end }}"{{ $d }}"{{ end }})) {
    if ((Test-Path $dir) -and (($env:PATH -split [IO.Path]::PathSeparator) -notcontains $dir)) {
        $env:PATH = $dir + [IO.Path]::PathSeparator + $env:PATH
    }
}

# --- tools (only if installed)
if (Get-Command mise -ErrorAction SilentlyContinue) { mise activate pwsh | Out-String | Invoke-Expression }
if (Get-Command zoxide -ErrorAction SilentlyContinue) { zoxide init powershell --cmd cd | Out-String | Invoke-Expression }
Set-PSReadLineOption -EditMode Emacs -PredictionSource History -ErrorAction SilentlyContinue

# --- aliases (built-in aliases like gc/gp/gl/gm shadow functions, so drop them first)
{{- range .shell.aliases }}
{{- if or (not (hasKey . "os")) (has $os .os) }}
Remove-Item -Path 'Alias:{{ .name }}' -Force -ErrorAction SilentlyContinue
{{- if contains "{args}" .cmd }}
function global:{{ .name }} { {{ .cmd | replace "{args}" "@args" }} }
{{- else }}
function global:{{ .name }} { {{ .cmd }} @args }
{{- end }}
{{- end }}
{{- end }}

# --- machine-specific dev tools
$devTools = Join-Path $HOME '.config/powershell/dev-tools'
if (Test-Path $devTools) {
    Get-ChildItem -Path $devTools -Filter '*.ps1' | Sort-Object Name | ForEach-Object { . $_.FullName }
}
