#!/usr/bin/python3
"""Pick a local Docker image and a command with fzf, then run it interactively.

Usage: docker-run
Requires: fzf, docker

The command prompt accepts a typed command too (fzf --print-query).
"""
import os
import shlex
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "scripts"))
from common import err, fzf, output, require  # noqa: E402

COMMANDS = ["bash", "sh", "ash", "zsh", "powershell", "cmd", "ls -la", "top", "ps aux"]

require("fzf", "docker")
images = output(["docker", "images", "--format", "{{.Repository}}:{{.Tag}}"]).splitlines()
picked = fzf(images, "--height", "40%", "--border", "--prompt=Select Docker Image > ")
if not picked:
    err("No image selected.")
    sys.exit(1)
image = picked[0]

# --print-query: first line is what was typed, second the match (if any)
lines = fzf(COMMANDS, "--height", "40%", "--border", "--print-query",
            "--prompt=Select or type command > ")
command = lines[-1] if lines else ""
if not command:
    err("No command provided.")
    sys.exit(1)

argv = ["docker", "run", "-it", "--rm", image, *shlex.split(command)]
print("Executing:", shlex.join(argv))
os.execvp("docker", argv)
