#!/usr/bin/python3
"""Pick a project (~/Code/<group>/<project>) with fzf, kill its tmux session, delete it.

Usage: delete-project
"""
import shutil
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "scripts"))
from common import confirm, fzf, run, succeeds  # noqa: E402

code = Path.home() / "Code"
projects = sorted(str(p) for group in code.glob("*/") for p in group.glob("*/")) if code.is_dir() else []
picked = fzf(projects, "--prompt=Select a project to delete: ")
if not picked:
    print("No project selected.")
    sys.exit(1)

path = Path(picked[0])
if not confirm(f"Are you sure you want to delete '{path.name}' at '{path}'?"):
    print("Cancelled.")
    sys.exit(0)

if succeeds(["tmux", "has-session", "-t", path.name]):
    run(["tmux", "kill-session", "-t", path.name])
    print(f"Killed tmux session '{path.name}'.")

shutil.rmtree(path)
print(f"Deleted project folder '{path}'.")
