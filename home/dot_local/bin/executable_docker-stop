#!/usr/bin/python3
"""Pick running Docker containers with fzf (Tab to multi-select) and stop them.

Usage: docker-stop
Requires: fzf, docker
"""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "scripts"))
from common import fzf, output, require  # noqa: E402

require("fzf", "docker")
table = output(["docker", "ps", "--format", "table {{.ID}}\t{{.Image}}\t{{.Names}}\t{{.Status}}"])
picked = fzf(table.splitlines(), "--height", "40%", "--border", "--header-lines=1",
             "--prompt=Select containers to STOP > ", multi=True)
if not picked:
    print("No containers selected to stop.")
    sys.exit(0)

ids = [line.split()[0] for line in picked]
print("Stopping the following containers:", *ids, sep="\n")
os.execvp("docker", ["docker", "stop", *ids])
