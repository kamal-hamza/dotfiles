#!/usr/bin/python3
"""Manage machine-specific dev-tool shell env files (not tracked in git).

Usage:
  dev-tool list              List example templates and active configs
  dev-tool add <tool>        Enable a tool from its example template
  dev-tool edit <tool>       Edit an existing tool configuration
  dev-tool remove <tool>     Remove a tool configuration
  dev-tool show <tool>       Show a tool configuration

Works on fish by default (~/.config/fish/dev-tools/<tool>.fish, from
<tool>.fish.example). DEV_TOOL_SHELL=zsh manages the legacy
~/.config/zsh/dev-tools/*.zsh files instead.
"""
import argparse
import os
import shlex
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "scripts"))
from common import confirm, die, err, info, ok, warn  # noqa: E402

SHELL = os.environ.get("DEV_TOOL_SHELL", "fish")
if SHELL not in ("fish", "zsh"):
    die(f"DEV_TOOL_SHELL must be fish or zsh (got '{SHELL}')")
DIR = Path.home() / ".config" / SHELL / "dev-tools"
EDITOR = os.environ.get("EDITOR", "vim")


def config(tool: str) -> Path:
    return DIR / f"{tool}.{SHELL}"


def example(tool: str) -> Path:
    return DIR / f"{tool}.{SHELL}.example"


def edit(path: Path) -> None:
    subprocess.run([*shlex.split(EDITOR), str(path)])


def existing(tool: str) -> Path:
    path = config(tool)
    if not path.is_file():
        err(f"No configuration found for '{tool}'")
        info(f"Use 'dev-tool add {tool}' to create it")
        sys.exit(1)
    return path


def cmd_list(_args) -> None:
    if not DIR.is_dir():
        die(f"Dev tools directory not found: {DIR}")
    templates = {p.name.removesuffix(f".{SHELL}.example") for p in DIR.glob(f"*.{SHELL}.example")}
    active = {p.stem for p in DIR.glob(f"*.{SHELL}")}
    if not templates and not active:
        warn("No example templates or configurations found")
        return
    print("\nAvailable example templates:\n")
    for tool in sorted(templates | active):
        if tool not in active:
            print(f"  ○ {tool} (available)")
        elif tool in templates:
            print(f"  ✓ {tool} (active)")
        else:
            print(f"  ✓ {tool} (active, custom)")
    print()


def cmd_add(args) -> None:
    src, dst = example(args.tool), config(args.tool)
    if not src.is_file():
        err(f"No example template found for '{args.tool}'")
        cmd_list(args)
        sys.exit(1)
    if dst.exists():
        warn(f"Configuration already exists for '{args.tool}'")
        info(f"Use 'dev-tool edit {args.tool}' to modify it")
        sys.exit(1)
    dst.write_text(src.read_text())
    ok(f"Created {args.tool} configuration")
    info(f"Edit the file to uncomment and configure: {EDITOR} {dst}")
    if confirm("Open in editor now?"):
        edit(dst)


def cmd_edit(args) -> None:
    edit(existing(args.tool))
    ok(f"Updated {args.tool} configuration")


def cmd_remove(args) -> None:
    path = existing(args.tool)
    if confirm(f"Remove {args.tool} configuration?"):
        path.unlink()
        ok(f"Removed {args.tool} configuration")
    else:
        info("Cancelled")


def cmd_show(args) -> None:
    path = existing(args.tool)
    rule = "━" * 44
    print(f"\nConfiguration for {args.tool}:\n{rule}\n{path.read_text().rstrip()}\n{rule}\n")


parser = argparse.ArgumentParser(prog="dev-tool", description=__doc__.splitlines()[0],
                                 epilog="examples: dev-tool list | dev-tool add bun | dev-tool show go")
sub = parser.add_subparsers(dest="command", required=True, metavar="command")
sub.add_parser("list", help="list example templates and active configs").set_defaults(func=cmd_list)
for name, func, text in [("add", cmd_add, "enable a tool from its example template"),
                         ("edit", cmd_edit, "edit an existing tool configuration"),
                         ("remove", cmd_remove, "remove a tool configuration"),
                         ("show", cmd_show, "show a tool configuration")]:
    p = sub.add_parser(name, help=text)
    p.add_argument("tool")
    p.set_defaults(func=func)

args = parser.parse_args()
args.func(args)
