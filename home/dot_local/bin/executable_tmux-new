#!/usr/bin/python3
"""Open (or jump to) a tmux session for a project folder.

Usage: tmux-new [path]   (no path: pick one from ~/Code and ~/.local/share with fzf)

The session is named after the folder (dots become underscores). Inside tmux
it switches the client to the session instead of nesting.
"""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "scripts"))
from common import fzf, output, succeeds  # noqa: E402

ROOTS = [Path.home() / "Code", Path.home() / ".local" / "share"]


def subdirs(path: Path) -> list[Path]:
    try:
        return sorted(p for p in path.iterdir() if p.is_dir())
    except OSError:  # missing / unreadable
        return []


def candidates():
    for root in ROOTS:
        for child in subdirs(root):
            yield str(child)
            yield from map(str, subdirs(child))


if len(sys.argv) == 2:
    selected = sys.argv[1]
else:
    picked = fzf(candidates())
    if not picked:
        sys.exit(0)
    selected = picked[0]

path = str(Path(selected).expanduser().resolve())
name = Path(path).name.replace(".", "_")
in_tmux = bool(os.environ.get("TMUX"))
server_up = succeeds(["tmux", "list-sessions"])

if not in_tmux and not server_up:
    os.execvp("tmux", ["tmux", "new-session", "-s", name, "-c", path])

if not succeeds(["tmux", "has-session", f"-t={name}"]):
    output(["tmux", "new-session", "-ds", name, "-c", path])

if in_tmux:
    os.execvp("tmux", ["tmux", "switch-client", "-t", name])
os.execvp("tmux", ["tmux", "attach", "-t", name])
