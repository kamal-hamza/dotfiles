#!/usr/bin/python3
"""Fuzzy-find a man page; show its tldr page if there is one, else the man page.

Usage: man-tldr
Requires: fzf, tldr, apropos (man-db)
"""
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "scripts"))
from common import fzf, output, require, succeeds  # noqa: E402

require("fzf", "tldr")
pages = output(["apropos", "."], check=False).splitlines()
picked = fzf(pages, "--prompt=Man Page Search: ", "--cycle", "--bind", "tab:down,shift-tab:up")
if not picked:
    print("No command selected.")
    sys.exit(0)

# "ls (1)  - list directory contents" / "ls(1) - ..." -> "ls"
cmd = re.split(r"[\s(]", picked[0], maxsplit=1)[0]
if succeeds(["tldr", cmd]):
    print(f"TLDR page found for '{cmd}'. Displaying:")
    os.execvp("tldr", ["tldr", cmd])
print(f"No TLDR page found for '{cmd}'. Displaying man page:")
os.execvp("man", ["man", cmd])
