#!/usr/bin/python3
"""Create a project in ~/Code from a GitHub template, a clone, or empty, then
open it in a tmux session with $EDITOR.

Usage: create-project
Env:   CODE_DIR (default ~/Code), EDITOR (default zed)
Requires: gh, fzf, git, tmux (dotnet for .NET templates)

Templates come from the kamal-hamza-templates GitHub org. After cloning, a
template's .template/init.sh is run with the project name (then removed);
failing that, a .NET template (.template.config/) is instantiated.
"""
import json
import os
import shlex
import shutil
import termios
import tty
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "scripts"))
from common import die, fzf, info, ok, output, run, succeeds  # noqa: E402

CODE_DIR = Path(os.environ.get("CODE_DIR", Path.home() / "Code"))
EDITOR = shlex.split(os.environ.get("EDITOR", "zed"))
TEMPLATES_ORG = "kamal-hamza-templates"


def read_key() -> str:
    """One keypress, without echo or Enter."""
    if not sys.stdin.isatty():
        return sys.stdin.read(1)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        return sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def ask_name() -> str:
    name = input("\nProject Name: ").strip()
    if not name or "/" in name:
        die("Invalid project name.")
    return name


def pick_template() -> str | None:
    info(f"Fetching templates from {TEMPLATES_ORG}...")
    repos = json.loads(output(["gh", "repo", "list", TEMPLATES_ORG, "--limit", "100",
                               "--json", "name,description"]))
    width = max((len(r["name"]) for r in repos), default=0)
    rows = [f"{r['name']:<{width}}  {r['description'] or 'No description'}" for r in repos]
    picked = fzf(rows, "--height", "50%", "--reverse", "--prompt=Select Template: ",
                 f"--header=Templates from {TEMPLATES_ORG}")
    return picked[0].split()[0] if picked else None


def transform_template(name: str, path: Path) -> None:
    os.chdir(path)
    hook = Path(".template/init.sh")
    if hook.is_file():
        info("Running custom template initialization...")
        hook.chmod(0o755)
        run([f"./{hook}", name])
        shutil.rmtree(".template")
    elif Path(".template.config").is_dir():
        info("Applying .NET template transformation...")
        short = json.loads(Path(".template.config/template.json").read_text())["shortName"]
        short = short[0] if isinstance(short, list) else short  # string or list
        run(["dotnet", "new", "install", "."], quiet=True)
        run(["dotnet", "new", short, "-n", name, "--force"], quiet=True)
        ok(f".NET Project '{name}' initialized.")

    if Path(".git").is_dir():
        run(["git", "add", "."])
        run(["git", "commit", "-m", "Apply template transformations"], check=False)
        if not succeeds(["git", "push", "origin", "main"]):
            info("Push skipped (check permissions).")


def from_template() -> tuple[str, Path]:
    template = pick_template()
    if not template:
        sys.exit(0)
    name = ask_name()
    info(f"Creating {name} from {TEMPLATES_ORG}/{template}...")
    run(["gh", "repo", "create", name, "--template", f"{TEMPLATES_ORG}/{template}",
         "--private", "--clone"], cwd=CODE_DIR)
    transform_template(name, CODE_DIR / name)
    return name, CODE_DIR / name


def clone() -> tuple[str, Path]:
    info("Fetching your repositories...")
    picked = fzf(output(["gh", "repo", "list", "--limit", "100"]).splitlines(),
                 "--height", "50%", "--reverse")
    if not picked:
        sys.exit(0)
    repo = picked[0].split()[0]
    name = repo.rsplit("/", 1)[-1]
    run(["gh", "repo", "clone", repo], cwd=CODE_DIR)
    return name, CODE_DIR / name


def empty() -> tuple[str, Path]:
    name = ask_name()
    path = CODE_DIR / name
    path.mkdir(parents=True, exist_ok=True)
    run(["git", "init"], cwd=path)
    (path / "README.md").touch()
    ok("Empty project created.")
    return name, path


def open_project(name: str, path: Path) -> None:
    os.chdir(path)
    if os.environ.get("TMUX"):
        run([*EDITOR, "."])
        ok(f"Opened in {EDITOR[0]}.")
        return
    if not succeeds(["tmux", "has-session", "-t", name]):
        run(["tmux", "new-session", "-s", name, "-c", str(path), "-d"])
        run(["tmux", "send-keys", "-t", name, shlex.join([*EDITOR, "."]), "C-m"])
    os.execvp("tmux", ["tmux", "attach-session", "-t", name])


CODE_DIR.mkdir(parents=True, exist_ok=True)
print("\nProject Creator")
print("Choose: [t]emplate, [c]lone, [e]mpty, [q]uit")
key = read_key()
actions = {"t": from_template, "c": clone, "e": empty}
if key in ("q", "\x03", "\x1b"):  # q, Ctrl-C, Esc
    sys.exit(0)
if key not in actions:
    die(f"Invalid key '{key}'.")
open_project(*actions[key]())
