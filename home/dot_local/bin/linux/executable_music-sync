#!/usr/bin/env python3
"""Bring the beets DB and MPD playlists back in line with the files on disk.

Run after editing tags in Picard (or any other tagger):

1. Re-reads tags into the beets DB for every file changed since beets last
   saw it, and drops rows for files deleted by hand -- the Library launcher
   and beets' duplicate check read from that DB, not the files.
2. Repairs MPD's saved playlists (~/.config/mpd/playlists/*.m3u).

MPD playlists are plain lists of file paths, so they break whenever a track
is renamed (Picard, beets, a library rebuild). This records each entry's
identity in a manifest under ~/.local/state/music-import/playlists/ -- the
FLAC audio MD5 (survives any rename or retag), its MusicBrainz recording id,
and artist/title -- and re-points dead entries at wherever that track lives
now. Identity is read from the files themselves, not the beets DB, so files
Picard renamed/retagged behind beets' back are still found.

Both also run automatically as part of `music-import` (playlists also
around `music-fix-albums`). Run it by hand after Picard, and after creating
playlists (`mpc save`, ncmpcpp, ...) to snapshot them right away.

Exit codes: 0 every entry resolves, 2 some entries still point at nothing.
"""
import argparse
import signal
import sys
from pathlib import Path

signal.signal(signal.SIGPIPE, signal.SIG_DFL)
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'lib' / 'music'))
import musiclib as m


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--dry-run', action='store_true', help="show what would change, don't write anything")
    args = ap.parse_args()

    with m.lock('music-sync'):
        lib = m.setup()
        pruned = 0 if args.dry_run else m.prune_missing(lib)
        refreshed = m.refresh_library(lib, dry_run=args.dry_run)
        result = m.sync_playlists(dry_run=args.dry_run)

    if pruned:
        print(f"pruned {pruned} missing track(s) from the library")
    print(f"{'would update' if args.dry_run else 'updated'} tags for {refreshed} track(s) in the beets DB")
    verb = 'would repair' if args.dry_run else 'repaired'
    print(f"checked {result['playlists']} playlist(s), {verb} {result['repaired']} entr{'y' if result['repaired'] == 1 else 'ies'}")
    if result['unresolved']:
        print(f"{len(result['unresolved'])} entr{'y' if len(result['unresolved']) == 1 else 'ies'} still point at nothing:")
        for line in result['unresolved']:
            print(f'  {line}')
        return 2
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
