#!/usr/bin/python3
"""Toggle MPD random (shuffle) mode and notify the new state.

Usage: toggle-shuffle
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "scripts"))
from common import mpd_status, notify, run  # noqa: E402

turn_on = mpd_status().get("random") != "on"
run(["mpc", "-q", "random", "on" if turn_on else "off"])
notify("Shuffle Mode", f"Shuffle: {'On' if turn_on else 'Off'}")
