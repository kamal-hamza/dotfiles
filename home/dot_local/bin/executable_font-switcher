#!/usr/bin/python3
"""Font Switcher - pick a monospace font with fzf, write it to the chezmoi
source's .chezmoidata/fonts.yaml (font_family), then `chezmoi apply`.

Usage: font-switcher [--list | --current | --preview | --help]

NOTE: nothing in the repo reads fonts.yaml anymore (fonts are set per app),
and the file doesn't exist, so selecting a font currently errors out.
"""
import argparse
import platform
import re
import shlex
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "scripts"))
from common import confirm, die, output, require, succeeds, warn  # noqa: E402

MONO_HINT = re.compile(
    r"mono|consolas|courier|menlo|monaco|inconsolata|source.*code|fira.*code|jetbrains|hack|"
    r"sf.*mono|liga|meslo|cascadia|nerd.*font|iosevka|victor.*mono|fantasque|commit.*mono|"
    r"anonymous.*pro|pt.*mono|dejavu.*sans.*mono|liberation.*mono|ubuntu.*mono|roboto.*mono",
    re.IGNORECASE)
POPULAR = """Menlo|Monaco|JetBrains Mono|JetBrainsMono Nerd Font|Fira Code|FiraCode Nerd Font|Hack
Hack Nerd Font|Source Code Pro|SourceCodePro Nerd Font|IBM Plex Mono|Cascadia Code|Cascadia Mono
SF Mono|SFMono Nerd Font Mono|Inconsolata|Consolas|DejaVu Sans Mono|Ubuntu Mono|Roboto Mono
MesloLGS Nerd Font|Fantasque Sans Mono|Victor Mono|Iosevka|Intel One Mono|Commit Mono"""
SAMPLE = """The quick brown fox jumps over the lazy dog
THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG
0123456789 !@#$%^&*()_+-=[]{}|;:',.<>?/~`
iI1lL oO0 "'` ,;:. != () {} [] <>

function fibonacci(n) {
    if (n <= 1) return n;
    return fibonacci(n - 1) + fibonacci(n - 2);
}"""
IS_MAC = platform.system() == "Darwin"


def fonts_config() -> Path:
    src = output(["chezmoi", "source-path"], check=False).strip()
    return Path(src or Path.home() / ".local/share/chezmoi/home") / ".chezmoidata" / "fonts.yaml"


def system_fonts() -> list[str]:
    if IS_MAC:
        lines = output(["system_profiler", "SPFontsDataType"], check=False).splitlines()
        families = {l.split("Family:", 1)[1].strip() for l in lines if "Family:" in l}
        return sorted(f for f in families if MONO_HINT.search(f))
    return sorted({l.split(",")[0].strip() for l in output(["fc-list", ":mono", "family"], check=False).splitlines() if l.strip()})


def all_fonts() -> list[str]:
    return system_fonts() or sorted(set(re.split(r"[|\n]", POPULAR)))


def current_font() -> str:
    path = fonts_config()
    if path.is_file():
        m = re.search(r'^font_family:\s*"?([^"\n]*)"?', path.read_text(), re.MULTILINE)
        if m:
            return m.group(1).strip()
    return "Menlo"


def set_font(font: str) -> None:
    path = fonts_config()
    if not path.is_file():
        die(f"fonts.yaml not found at {path}")
    text = re.sub(r"^font_family:.*$", f'font_family: "{font}"', path.read_text(), flags=re.MULTILINE)
    path.write_text(text)


def preview(font: str) -> None:
    rule = "━" * 54
    print(f"{rule}\nFont: {font}\n{rule}\n{SAMPLE}\n{rule}")


def interactive() -> None:
    require("fzf")
    current = current_font()
    print("Font Switcher - Select a Font\n")
    print(f"Current font: {current}\n\nLoading available fonts...")
    proc = subprocess.run(
        ["fzf", "--prompt=Select font: ", "--height=20", "--layout=reverse", "--border=rounded",
         "--preview", f"printf 'Font: %s\\n\\n%s\\n' {{}} {shlex.quote(SAMPLE)}", "--preview-window=up:12",
         f"--header=Current: {current} | ↑↓: Navigate | Enter: Select | Esc: Cancel"],
        input="\n".join(all_fonts()), text=True, stdout=subprocess.PIPE)
    font = proc.stdout.strip()
    if not font:
        print("No font selected. Exiting.")
        return
    if font == current:
        print("Selected font is already the current font. No changes made.")
        return
    if IS_MAC and font not in system_fonts():
        warn(f"Font '{font}' may not be installed on your system; apps may fall back to another font.")
        if not confirm("Continue anyway?"):
            print("Font change cancelled.")
            return
    print(f"\nSelected font: {font}\n\nUpdating fonts.yaml...")
    set_font(font)
    print("Applying changes with chezmoi...")
    if not succeeds(["chezmoi", "apply"]):
        die("Error applying changes with chezmoi")
    print(f"\n✓ Font successfully changed to: {font}\n")
    print("You may need to restart or reload your applications (WezTerm, Neovim).")


parser = argparse.ArgumentParser(prog="font-switcher", description=__doc__.splitlines()[0])
group = parser.add_mutually_exclusive_group()
group.add_argument("-l", "--list", action="store_true", help="list all available fonts")
group.add_argument("-c", "--current", action="store_true", help="show current font")
group.add_argument("-p", "--preview", action="store_true", help="preview current font")
args = parser.parse_args()

if args.list:
    print("Available fonts:", *all_fonts(), sep="\n")
elif args.current:
    print(f"Current font: {current_font()}")
elif args.preview:
    preview(current_font())
else:
    interactive()
