# GENERATED by chezmoi from .chezmoidata/shell.yaml - edit that file, not this one.
{{- $os := .chezmoi.os }}
{{- $env := merge (dict) (index .shell.env $os | default dict) .shell.env.common }}
{{- range $name := keys $env | sortAlpha }}
set -gx {{ $name }} "{{ index $env $name | toString | replace "\\" "\\\\" | replace "\"" "\\\"" }}"
{{- end }}

# PATH: -g keeps it out of universal variables (fish_variables); fish_add_path
# skips directories that don't exist. Reversed so the first entry ends up first.
{{- $path := concat (index .shell.path $os | default list) .shell.path.common }}
{{- range $dir := $path | reverse }}
fish_add_path -g -m "{{ $dir }}"
{{- end }}
