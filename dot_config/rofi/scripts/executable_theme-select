#!/usr/bin/env bash

# =============================================================================
# Theme Selector Script for Rofi
# =============================================================================
# Pick a theme via rofi and switch to it (colors + wallpaper) across every
# themed app, via the `theme` command.
#
# Usage:
#   theme-select
# =============================================================================

set -e

if ! command -v rofi &> /dev/null; then
    notify-send -u critical "Theme Select" "rofi not found"
    exit 1
fi

if ! command -v theme &> /dev/null; then
    notify-send -u critical "Theme Select" "theme command not found"
    exit 1
fi

current="$(theme current)"
themes="$(chezmoi execute-template '{{ range $k, $v := .themes }}{{ $k }}
{{ end }}' | sort)"

selected=$(echo "$themes" | rofi -dmenu -p "Theme:" -i -mesg "Current: $current")

# Cancelled or re-selected the already-active theme
if [ -z "$selected" ] || [ "$selected" == "$current" ]; then
    exit 0
fi

if theme set "$selected" &> /dev/null; then
    notify-send -u normal "Theme" "Switched to $selected"
else
    notify-send -u critical "Theme" "Failed to switch to $selected"
    exit 1
fi
