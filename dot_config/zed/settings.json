{
    "vim_mode": true,
    // theme
    "theme": "VSCode Dark Modern",
    // fonts
    "ui_font_family": "MesloLGS Nerd Font Mono",
    "buffer_font_family": "MesloLGS Nerd Font Mono",
    "ui_font_size": 14,
    "buffer_font_size": 15.5,
    "cursor_blink": false,
    "terminal": {
        "font_family": "MesloLGS Nerd Font Mono",
        "font_size": 14,
    },
    // tabs
    "tab_size": 4,
    "disable_ai": true,
    "session": {
        "trust_all_worktrees": true
    },
    "code_lens": "menu",
    "toolbar": {
        "code_actions": true,
    },
    "show_signature_help_after_edits": true,
    "auto_signature_help": false,
    "redact_private_values": true,
    "cli_default_open_behavior": "existing_window",
    "git": {
        "inline_blame": {
            "enabled": true,
        },
        "git_gutter": "hide"
    },
    "status_bar": {
        "active_encoding_button": "disabled",
        "cursor_position_button": false,
        "show_active_file": true,
    },
    "git_panel": {
        "collapse_untracked_diff": true,
        "show_count_badge": true,
        "diff_stats": true,
        "file_icons": true,
        "tree_view": true,
        "dock": "right",
    },
    "file_finder": {
        "file_icons": true,
        "modal_max_width": "medium"
    },
    "which_key": {
        "delay_ms": 500,
        "enabled": true,
    },
    "relative_line_numbers": "enabled",
    "vertical_scroll_margin": 4,
    "horizontal_scroll_margin": 8,
    "scrollbar": {
        "show": "never",
    },
    "minimap": {
        "show": "always"
    },
    "inlay_hints": {
        "enabled": false,
    },
    "file_scan_exclusions": [
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/CVS",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/.classpath",
        "**/.settings",
        "**/out",
        "**/dist",
        "**/.husky",
        "**/.turbo",
        "**/.vscode-test",
        "**/.vscode",
        "**/.next",
        "**/.storybook",
        "**/.tap",
        "**/.nyc_output",
        "**/report",
        "**/node_modules",
    ],
    "project_panel": {
        "hide_root": false,
        "git_status_indicator": true,
        "diagnostic_badges": true,
        "show_diagnostics": "errors",
        "auto_fold_dirs": false,
        "button": true,
        "dock": "right",
        "git_status": true,
    },
    "outline_panel": {
        "dock": "right"
    },
    "collaboration_panel": {
        "dock": "right"
    },
}
