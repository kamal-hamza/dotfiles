{{- $t := index .themes .theme -}}
# =============================================================================
# Mako Configuration - generated from the active theme ({{ $t.meta.name }})
# =============================================================================

# Global notification settings
background-color={{ $t.background.bg_hover }}
text-color={{ $t.foreground.fg_high }}
border-color={{ $t.ui.line }}
border-radius=4
border-size=1
margin=15
padding=15
font=Source Sans 3 12
width=300
icons=1
max-visible=3
default-timeout=3000

# Clean format with a bold summary
format=<b>%s</b>\n%b
actions=1

# Urgency levels
[urgency=low]
background-color={{ $t.background.bg_dim }}
text-color={{ $t.foreground.fg_faint }}
border-color={{ $t.background.bg_hover_alt }}
default-timeout=2000

[urgency=normal]
# Defaults to global settings
default-timeout=3000

[urgency=high]
background-color={{ $t.background.bg_urgent }}
text-color={{ $t.foreground.fg_bright }}
border-color={{ $t.foreground.fg_faint }}
default-timeout=5000

[urgency=critical]
# Inverted colors for maximum visibility without using bright colors
background-color={{ $t.foreground.fg_high }}
text-color={{ $t.background.bg_dim }}
border-color={{ $t.foreground.fg_high }}
default-timeout=0

# App-specific styling
[app-name=screenshot]
background-color={{ $t.background.bg_hover }}
text-color={{ $t.foreground.fg_dim }}
border-color={{ $t.ui.line }}
default-timeout=2000

# Text pattern matching for special notifications
[summary~=battery]
text-color={{ $t.foreground.fg_active }}
border-color={{ $t.ui.dim }}

[summary~=error]
background-color={{ $t.background.bg_urgent }}
text-color={{ $t.foreground.fg_bright }}
border-color={{ $t.foreground.fg_dim }}
default-timeout=0

[body~=error]
background-color={{ $t.background.bg_urgent }}
text-color={{ $t.foreground.fg_bright }}
border-color={{ $t.foreground.fg_dim }}
