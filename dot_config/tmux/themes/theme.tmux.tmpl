{{- $t := index .themes .theme -}}
# Generated from the active theme ({{ $t.meta.name }}); see .chezmoidata/themes/
# Do not edit by hand - regenerated by `theme set <name>` via chezmoi apply.

# Copy mode
set -g mode-style "fg={{ $t.background.bg_hover_alt }},bg={{ $t.ui.highlight }},bold"

# Status bar
set -g status-style "fg={{ $t.foreground.fg_active }},bg={{ $t.background.bg_hover_alt }}"
set -g message-style "fg={{ $t.foreground.fg_bright }},bg={{ $t.ui.line }}"
set -g message-command-style "fg={{ $t.semantic.warning }},bg={{ $t.ui.line }}"

# Status left: session name
set -g status-left "#[fg={{ $t.background.bg_hover_alt }},bg={{ $t.ui.highlight }},bold] #S #[default] "

# Status right: current path and time
set -g status-right "#[fg={{ $t.ui.highlight }}]#{=/-32/...:#{b:pane_current_path}} #[fg={{ $t.ui.line }}]│#[fg={{ $t.ui.keyword }}] %H:%M "

# Window status
set -g window-status-style "fg={{ $t.ui.keyword }},bg={{ $t.background.bg_hover_alt }}"
set -g window-status-current-style "fg={{ $t.ui.highlight }},bg={{ $t.background.bg_hover_alt }},bold"
set -g window-status-activity-style "fg={{ $t.semantic.danger }},bg={{ $t.background.bg_hover_alt }}"

# Pane borders
set -g pane-border-style "fg={{ $t.ui.line }}"
set -g pane-active-border-style "fg={{ $t.ui.highlight }}"
